# Windows 本地单账号模式：与扫码登录脚本使用相同目录。
DOUYIN_USER_DATA_DIR=.browser-profile
TASK_CONFIG=config.json
ARTIFACTS_DIR=artifacts
HEADLESS=false
# 在后台运行；调试时可注释此行以显示浏览器。
BROWSER_ARGS=--headless=new
# Trace 含会话快照和私信内容，默认关闭。
TRACE=false

# 以下均为可选。不要在示例中填写真实凭证。
# BROWSER_PATH=C:\path\to\chrome.exe
# DOUYIN_COOKIE=cookie.json
# DOUYIN_STORAGE_STATE=storage-state.json
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
# WEBHOOK_URL=
# WEBHOOK_HEADERS={"Content-Type": "application/json"}
# WEBHOOK_TEMPLATE={"status": "{status}"}
